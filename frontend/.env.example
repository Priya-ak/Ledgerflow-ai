# Copy to frontend/.env.local. Only NEXT_PUBLIC_* values are exposed to the browser.

# Server-side only: where the Next.js proxy forwards /api/v1/* requests.
BACKEND_URL=http://127.0.0.1:8000

# Public, non-secret flags.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_CONTACT_EMAIL=hello@ledgerflow.example
