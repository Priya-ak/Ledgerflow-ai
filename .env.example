# =====================================================================
# LedgerFlow AI - backend configuration (copy to .env; never commit .env)
# Everything here is SERVER-SIDE. None of these values reach the browser.
# =====================================================================

# --- Environment ---------------------------------------------------------
# development | test | staging | production  (staging/production enforce secrets + secure cookies)
APP_ENV=development
LOG_LEVEL=INFO
DEMO_MODE=true

# --- Database ---------------------------------------------------------------
# Leave empty for the local SQLite fallback (backend/ledgerflow.db).
# Supabase: Project Settings > Database > Connection string (URI). Use the pooler
# URI for hosted backends. Example:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Secrets (REQUIRED outside development) ----------------------------------
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
SECRET_KEY=
JWT_EXPIRE_MINUTES=480

# --- Document storage ----------------------------------------------------------
# local | supabase   (use supabase on Render: its filesystem is ephemeral)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=10

# --- Supabase (optional; required only for STORAGE_PROVIDER=supabase) ---------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key bypasses RLS. Backend only. NEVER put it in frontend env files.
SUPABASE_SERVICE_ROLE_KEY=
# Create this bucket as PRIVATE in Supabase Storage.
SUPABASE_STORAGE_BUCKET=ledgerflow-documents

# --- OCR ---------------------------------------------------------------------------
# tesseract | none
OCR_ENGINE=tesseract
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe  (empty = use PATH)
TESSERACT_CMD=
OCR_DPI=200

# --- AI (optional - the app works fully with AI_PROVIDER=rules) -----------------
# rules | ollama | gemini
AI_PROVIDER=rules
AI_TIMEOUT_SECONDS=45
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b-instruct
OLLAMA_NUM_CTX=1024
# Gemini sends document text to Google. Requires BOTH a key and ALLOW_CLOUD_AI=true.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ALLOW_CLOUD_AI=false

# --- URLs ------------------------------------------------------------------------
# Comma-separated list of allowed browser origins for CORS.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Security and operations (added in v2) ---------------------------------------------------------------------
# Required when APP_ENV is staging or production. Fernet key that encrypts two-factor secrets:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Create the demo company on container start if it does not exist (hosted demos only; keep false for real data).
SEED_DEMO_ON_START=false
# Reverse proxies in front of the API (Vercel rewrite + Render = 2). 0 when the API is called directly.
TRUSTED_PROXY_HOPS=0
# Email: console (prints to the log) | brevo | smtp | none
EMAIL_PROVIDER=console
EMAIL_FROM=
EMAIL_FROM_NAME=LedgerFlow AI
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
# Frontend address used in email links (defaults to the first FRONTEND_URL)
APP_PUBLIC_URL=
MFA_ISSUER=LedgerFlow AI
# Virus scanning: none | clamav (ClamAV needs about 1 GB RAM). PDF active-content blocking is always on.
MALWARE_SCANNER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
MALWARE_SCAN_FAIL_CLOSED=true
# Encrypted backups (python -m app.ops.backup keygen prints a key; use a DIFFERENT key from ENCRYPTION_KEY)
BACKUP_ENCRYPTION_KEY=
BACKUP_DESTINATION=local
BACKUP_BUCKET=ledgerflow-backups
BACKUP_KEEP=14
